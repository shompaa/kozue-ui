{
  "name": "kozue-ui",
  "version": "0.1.1",
  "description": "Design system en React y Tailwind 4: tokens con 4 temas, primitivos accesibles y componentes de composición.",
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "ui",
    "components",
    "radix",
    "accessibility",
    "themes"
  ],
  "license": "MIT",
  "author": {
    "name": "shompaa",
    "url": "https://github.com/shompaa"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shompaa/kozue-ui.git"
  },
  "homepage": "https://shompaa.github.io/kozue-ui/",
  "bugs": {
    "url": "https://github.com/shompaa/kozue-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset.css": "./src/styles/preset.css",
    "./styles/*": "./src/styles/*",
    "./spotlight": {
      "types": "./dist/spotlight.d.ts",
      "import": "./dist/spotlight.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4.1"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-themes": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^31.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "^8.6.14",
    "tailwindcss": "^4.1.13",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vite": "^6.0.0",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@11.2.2"
}
